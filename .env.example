# Copy to .env and fill in your values.
# See .env for full instructions.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
VITE_APP_ENV=development

# Paystack public key (safe to expose — used by browser for inline widget)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Optional analytics (production only — skipped in DEV)
# VITE_POSTHOG_KEY=

# Web Push (public VAPID key — must match the VAPID_PUBLIC_KEY function secret)
# VITE_VAPID_PUBLIC_KEY=

# Server-side secrets → Supabase secrets only (never in .env):
# supabase secrets set GROQ_API_KEY=gsk_...
# supabase secrets set HF_API_TOKEN=hf_...            # scan-food vision (HF router VLM)
# supabase secrets set GROQ_MODEL=openai/gpt-oss-120b                 # optional override
# supabase secrets set HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct   # optional override
# supabase secrets set GROQ_VISION_MODEL=...          # only if your Groq account has a vision model
# supabase secrets set PAYSTACK_SECRET_KEY=sk_test_...
# supabase secrets set PAYSTACK_PLAN_CODE_PRO=PLN_...
# supabase secrets set PAYSTACK_PLAN_CODE_ELITE=PLN_...
# supabase secrets set SITE_URL=https://your-domain.com
